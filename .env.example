# =============================================================================
# GARAGE APP - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# NUNCA agregues claves reales ni contraseñas de producción en este archivo.
# =============================================================================

# --- EXPO / CLIENTE (Variables con prefijo EXPO_PUBLIC_ para la app móvil/web) ---
# URL de tu proyecto Supabase (https://<project-ref>.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave anónima pública de Supabase (anon public key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clave de API para consultas técnicas de motos (API Ninjas)
EXPO_PUBLIC_API_NINJAS_KEY=your-api-ninjas-key

# Servicio de Despacho Transaccional de Alertas SOS
EXPO_PUBLIC_FORMSUBMIT_URL=https://formsubmit.co/ajax
EXPO_PUBLIC_FORMSUBMIT_TOKEN=your-formsubmit-token

# Servicio de Detección de IP para auditoría de consentimientos legales
EXPO_PUBLIC_IP_LOOKUP_URL=https://api.ipify.org?format=json

# --- SCRIPTS ADMINISTRATIVOS & BASE DE DATOS (SOLO SERVIDOR / LOCAL - NUNCA EN EL CLIENTE) ---
# Cadena de conexión PostgreSQL Pooler (puerto 6543) o directa (puerto 5432)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
